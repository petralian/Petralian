{
  "_comment": "Copy to project .cursor/mcp.json or merge in Cursor Settings → MCP. See docs/TOKEN-STACK.md. Vault: native Read/Write on D:\\Obsidian\\... at desk — no vault MCP in this file.",
  "mcpServers": {
    "context7": {
      "_comment": "P0 — live library docs (Next.js, TinaCMS, etc.)",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "serena": {
      "_comment": "P1 — symbol-level repo nav. ${workspaceFolder} = active workspace root.",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "${workspaceFolder}"
      ]
    },
    "openseo": {
      "_comment": "P2 — GSC + keyword research (URL transport; works on cloud/iPhone when registered in Dashboard)",
      "url": "https://app.openseo.so/mcp"
    }
  }
}
