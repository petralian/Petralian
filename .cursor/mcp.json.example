{
  "_comment": "Copy to .cursor/mcp.json. Vault: Official Sync on D:\\ — native I/O or petralian-obsidian. See docs/TOKEN-STACK.md",
  "mcpServers": {
    "context7": {
      "_comment": "P0 — live library docs (Next.js, TinaCMS, etc.)",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "serena": {
      "_comment": "P1 — symbol-level repo nav. ${workspaceFolder} = active workspace root.",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "${workspaceFolder}"
      ]
    },
    "openseo": {
      "_comment": "P2 — GSC + keyword research (URL; cloud/iPhone via Dashboard)",
      "url": "https://app.openseo.so/mcp"
    },
    "petralian-obsidian": {
      "_comment": "Project vault on D:\\Obsidian\\...\\Petralian (same files as Official Sync)",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/obsidian-mcp-server.mjs"]
    }
  }
}
