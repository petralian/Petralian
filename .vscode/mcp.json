{
  "_comment": "Optional: petralian-obsidian + obsidian-brain on D:\\ (Official Sync). See docs/TOKEN-STACK.md",
  "servers": {
    "petralian-obsidian": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/obsidian-mcp-server.mjs"]
    },
    "obsidian-brain": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\Obsidian\\Obsidian\\00_Brain"
      ]
    }
  }
}
